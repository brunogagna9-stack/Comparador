{
  "extends": ["html-validate:recommended"],
  "rules": {
    "doctype-style": "off", "no-inline-style": "off", "long-title": "off", "no-trailing-whitespace": "off",
    "attribute-boolean-style": "off", "no-implicit-button-type": "off", "prefer-native-element": "off",
    "void-style": "off", "attribute-empty-style": "off", "no-raw-characters": "off", "prefer-tbody": "off",
    "wcag/h63": "off", "no-implicit-input-type": "off"
  }
}
